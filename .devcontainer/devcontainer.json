{
  "name": "CoCalc",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "forwardPorts": [80, 443, 8080, 8888, 9999],
  "portsAttributes": {
    "443": {
      "label": "CoCalc HTTPS",
      "onAutoForward": "notify"
    },
    "80": {
      "label": "HTTP",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "HTTP8080",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "notify"
    },
    "9999": {
      "label": "Sage Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.jupyter-hub",
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "user",
  "postCreateCommand": "pip install --upgrade pip && which sage && sage --version"
}